# AWF .gitignore
# ------------------------------------------------------------
# Secrets and local environment
# ------------------------------------------------------------
# root env files
/.env
/.env.local
/.env.*
# tracked example
!/.env.example

# local agent/client state
/.agents/
/.claude/
/.codex/

# ------------------------------------------------------------
# Python
# ------------------------------------------------------------
# bytecode / interpreter
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
# packaging / build outputs
build/
dist/
downloads/
develop-eggs/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
# virtual environments
.venv/
venv/
ENV/
env/
/backend/.venv/
/backend/venv/
# tooling caches
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------
# Testing and coverage artifacts
# ------------------------------------------------------------
.pytest_cache/
.coverage
htmlcov/
.tox/
coverage/

# ------------------------------------------------------------
# Frontend / Node
# ------------------------------------------------------------
# dependency dirs
node_modules/
# package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
# build/cache outputs (repo-root anchored)
/frontend/dist/
/frontend/.vite/
dist-ssr/
# local overrides
*.local

# ------------------------------------------------------------
# IDE / editor / OS
# ------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ------------------------------------------------------------
# Runtime data artifacts (local-first architecture)
# ------------------------------------------------------------
# base gate: block everything under /data/
/data/*

# re-include tree roots (directories must be re-included before their contents)
!/data/artifacts/
!/data/awf_db/
!/data/registry
!/data/registry/agents
!/data/registry/capabilities
!/data/registry/mcp/
!/data/registry/model-profiles/
!/data/registry/personas/
!/data/registry/skills/
!/data/registry/voice-profiles/
!/data/registry/workflows/

# data/agents (agent ledger; I.2)
/data/artifacts/*
!/data/artifacts/.gitkeep

# data/awf_db
/data/awf_db/*
!/data/awf_db/.gitkeep

# data/registry/agents
/data/registry/agents/*
!/data/registry/agents/.gitkeep

# data/registry/capabilities
/data/registry/capabilities/*
!/data/registry/capabilities/.gitkeep

# data/registry/mcp
/data/registry/mcp/*
!/data/registry/mcp/.gitkeep

# data/registry/model-profiles
/data/registry/model-profiles/*
!/data/registry/model-profiles/.gitkeep

# data/registry/personas
/data/registry/personas/*
!/data/registry/personas/.gitkeep

# data/registry/skills
/data/registry/skills/*
!/data/registry/skills/.gitkeep

# data/registry/voice-profiles
/data/registry/voice-profiles/*
!/data/registry/voice-profiles/.gitkeep

# data/registry/workflows
/data/registry/workflows/*
!/data/registry/workflows/.gitkeep

# generic runtime artifacts (fallback)
/data/**/*.db
/data/**/*.db-journal
/data/**/*.db-wal
/data/**/*.sqlite
/data/**/*.sqlite3
/data/**/*.log
/data/**/embeddings/**


# ------------------------------------------------------------
# Top-level cache/ (sandbox scratch space)
# ------------------------------------------------------------
/cache/*
/cache/sandbox/*
!/cache/sandbox/
!/cache/sandbox/.gitkeep

# ------------------------------------------------------------
# Backup files
# ------------------------------------------------------------
*.bak

# ------------------------------------------------------------
# Logs
# ------------------------------------------------------------
# global logs
*.log

# root logs dir only
/logs/

# ------------------------------------------------------------
# Reports (validation, diagnostics, benchmarks)
# ------------------------------------------------------------
/reports/*.txt
/reports/*.err
/reports/*.json
/reports/benchmarks/*
!/reports/benchmarks/.gitkeep
/reports/diagnostics/*
!/reports/diagnostics/.gitkeep
/reports/validation/*
!/reports/validation/.gitkeep
!/reports/.gitkeep

# helper-produced handoff packages
/docs/temp/

# ------------------------------------------------------------
# Model artifacts (per-folder allowlist; prevent large binary commits
# but permit `.gitkeep` placeholders)
# ------------------------------------------------------------
/models/llm/*
!/models/llm/.gitkeep
/models/stt/*
!/models/stt/.gitkeep
/models/tts/*
!/models/tts/.gitkeep
/models/vad/*
!/models/vad/.gitkeep
/models/wake/*
!/models/wake/.gitkeep

# ------------------------------------------------------------
# Runtimes (acquired sidecar binaries; gitignored in full)
# ------------------------------------------------------------
/runtimes/*
!/runtimes/.gitkeep
!/runtimes/llama.cpp/.gitkeep


# Model binary extensions (anywhere): kept out of source.
# Note: `.onnx` is NOT globally banned — ONNX models live under /models/**
# and are gated by the per-folder rules above. Other locations (tests/fixtures)
# should hold small ONNX files only when intentional.
**/*.exe
**/*.dll
**/*.zip
**/*.gguf
**/*.bin
**/*.safetensors
**/*.pt
**/*.pth
**/*.ckpt
**/*.ppn
