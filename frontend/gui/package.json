{
  "name": "awf-gui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node esbuild.config.js && node -e \"require('fs').copyFileSync('src/renderer/index.html', 'dist/renderer/index.html')\"",
    "test": "vitest run",
    "start": "electron ./dist/main/main.js"
  },
  "dependencies": {
    "@awf/protocol-client": "*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "jsdom": "^30.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/jest-dom": "^7.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^22.10.0"
  }
}
